# Supply-chain hardening: reject any package version published less than 3 days ago.
# Time window for the community / security researchers to spot malicious uploads
# (e.g. typo-squatting, account compromises like the Sept 2025 Shai-Hulud npm worm)
# before they land in our installs. pnpm 10.5+ feature.
minimum-release-age=4320

# Refuse to silently use a pnpm version different from the one in packageManager.
# Stops a CI environment from picking up a different pnpm release without us noticing.
package-manager-strict=true
